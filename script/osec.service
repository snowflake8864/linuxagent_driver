[Unit]
Description= osec.service
#After=network.target auditd.service multi-user.target graphical.target
After=network.target auditd.service 

[Service]
Type=simple   
#ExecStartPre=/bin/bash -c 'if [ $(($(date +%s) - $(cat /proc/uptime | cut -d. -f1))) -lt 120 ]; then sleep 20; fi'
ExecStartPre=/opt/osec/pre_start.sh
ExecStart=/opt/osec/MagicArmor_0
ExecReload=/bin/kill -HUP $MAINPID
KillMode=process
Restart=on-failure
Restart=always
RestartSec=5
[Install]
WantedBy=multi-user.target
#Alias=osec.service
