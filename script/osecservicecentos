#!/bin/bash
#
# MagicArmor_0        Startup script for the MagicArmor_0
#
# chkconfig: 2345 98 15
# description: This Service is used to start MagicArmor_0.
# processname: MagicArmor_0

PROC_FILE="MagicArmor_0"

start()
{
    /opt/osec/osecmonitor &
}

stop()
{
#    /opt/osec/MagicArmor_2
    pkill -10 MagicArmor
    pkill -10 MagicArmor
}

status()
{
    run_status=$(ps -e|grep MagicArmor_0)
    if [ "${run_status}X" == "X" ]; then
        echo "MagicArmor_0 is not running..."
    else
        echo "MagicArmor_0 is running"
    fi
}

case "$1" in
start)
    start
    ;;
stop)
    stop
    ;;
restart)
    stop
    start
    ;;
status)
    status
    ;;
*)
    echo "usage: $0 start|stop|restart"
    exit 0;
esac

