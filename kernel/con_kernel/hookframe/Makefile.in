kvd-objs += $(KVDDIR)/hook/syscall_name.o
kvd-objs += $(KVDDIR)/hook/kallsyms.o
kvd-objs += $(KVDDIR)/hook/arch/hook_arch.o
kvd-objs += $(KVDDIR)/hook/hook_ops.o
kvd-objs += $(KVDDIR)/hook/kvd_syscalls.o 

kvd_core-objs += $(KVDDIR)/core/kvd_version.o 
kvd_core-objs += $(KVDDIR)/core/kvd_blm.o
kvd_core-objs += $(KVDDIR)/core/kvd_memcache.o 
